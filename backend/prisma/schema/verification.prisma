

model Verification {
  id                  String             @id @default(uuid())
  userId              String
  status              VerificationStatus
  verdict             String?            // V2 verdict: VERIFIED | HIGH_CONFIDENCE | SUSPICIOUS | HIGH_RISK | REJECTED | UNVERIFIABLE
  confidence          Int                @default(0)
  evidenceType        String             @default("BANK_RECEIPT")
  provider            String?
  transactionId       String?
  transferReference   String?
  senderName          String?
  senderAccount       String?
  senderPhone         String?
  receiverName        String?
  receiverAccount     String?
  receiverPhone       String?
  amount              Float?
  fees                Float?
  totalAmount         Float?
  currency            String             @default("ETB")
  date                String?
  time                String?
  paymentMethod       String?
  reasons             String[]           @default([])
  warnings            String[]           @default([])
  imageUrl            String?
  receiptUrl          String?

  // V2 Structured Payload Storage
  normalizedTransaction Json?
  fraudSignals          Json?
  timeline              Json?
  scrapedData           Json?
  crossValidation       Json?
  domainValidation      Json?
  riskAssessment        Json?

  // Duplicate detection
  isDuplicate         Boolean            @default(false)
  duplicateOf         String?
  receiptHash         String?

  // Optional link to Provider Namespace Transaction Record
  transactionRefId    String?
  transaction         Transaction?       @relation(fields: [transactionRefId], references: [id], onDelete: SetNull)

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  branchId            String?
  branch              Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@index([provider])
  @@index([receiptHash])
  @@index([createdAt])
  @@map("verifications")
}


enum VerificationStatus {
  APPROVED
  SUSPICIOUS
  REJECTED
}