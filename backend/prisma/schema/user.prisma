model User {
  id           String  @id @default(uuid())
  firstName    String
  lastName     String
  email        String  @unique
  password     String
  phoneNumber  String?
  businessName String?
  photo        String?
  refreshToken String? @db.Text

  businessType       String       @default("Other")
  role               ROLE         @default(CUSTOMER)
  plan               Plan         @default(FREE)
  provider           AuthProvider @default(CREDENTIALS)
  providerId         String?      @unique
  verificationsUsed  Int          @default(0)
  verificationsLimit Int          @default(20)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  ownerId            String?
  owner              User?        @relation("TeamMembers", fields: [ownerId], references: [id], onDelete: Cascade)
  teamMembers        User[]       @relation("TeamMembers")

  branchId           String?
  branch             Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branches           Branch[]     @relation("OwnerBranches")

  verifications Verification[]
  payments      Payment[]
  notifications Notification[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]

  @@map("users")
}

enum ROLE {
  ADMIN
  CUSTOMER
  MANAGER
  CASHIER
  VIEWER
}

enum AuthProvider {
  CREDENTIALS
  TELEGRAM
}
